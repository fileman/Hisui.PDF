<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hisui.Pdf.App.Localization"
        x:Class="Hisui.Pdf.App.Views.PrintDialog"
        Width="760" Height="560"
        MinWidth="680" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, $Default"
        Background="{DynamicResource RibbonBarBrush}">
    <Window.Styles>
        <Style Selector="Button.navbtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource RibbonSubtleTextBrush}" />
        </Style>
        <Style Selector="Button.navbtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.navbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RibbonHoverBrush}" />
        </Style>
    </Window.Styles>

    <Grid Margin="18" ColumnDefinitions="300,18,*">

        <!-- ── Preview ── -->
        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="navbtn" x:Name="PrevButton" Content="‹"
                        ToolTip.Tip="{loc:Tr Print.Prev}" />
                <TextBlock Grid.Column="1" x:Name="PageLabel" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource RibbonSubtleTextBrush}" />
                <Button Grid.Column="2" Classes="navbtn" x:Name="NextButton" Content="›"
                        ToolTip.Tip="{loc:Tr Print.Next}" />
            </Grid>

            <Border Background="{DynamicResource RibbonPreviewBrush}" CornerRadius="4"
                    BorderBrush="{DynamicResource RibbonDividerBrush}" BorderThickness="1" Padding="14">
                <Border Background="{DynamicResource RibbonPageBrush}"
                        BorderBrush="{DynamicResource RibbonPageBorderBrush}" BorderThickness="1">
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                </Border>
            </Border>
        </DockPanel>

        <!-- ── Options ── -->
        <DockPanel Grid.Column="2">

            <!-- Buttons pinned to the bottom -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="{loc:Tr Dialog.Cancel}" Padding="16,6" IsCancel="True" />
                <Button x:Name="PrintButton" Content="{loc:Tr Print.Ok}" Classes="primary" IsDefault="True" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="3">
                        <TextBlock Classes="caption" Text="{loc:Tr Print.Printer}" />
                        <ComboBox x:Name="PrinterCombo" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="NoPrintersLabel" Text="{loc:Tr Print.NoPrinters}" IsVisible="False"
                                   Classes="error-text" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock Classes="caption" Text="{loc:Tr Print.Copies}" />
                        <NumericUpDown x:Name="CopiesBox" Minimum="1" Maximum="99" Increment="1" Value="1"
                                       FormatString="0" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock Classes="caption" Text="{loc:Tr Print.Duplex}" />
                        <ComboBox x:Name="DuplexCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="{loc:Tr Print.Duplex.Simplex}" />
                            <ComboBoxItem Content="{loc:Tr Print.Duplex.Long}" />
                            <ComboBoxItem Content="{loc:Tr Print.Duplex.Short}" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Classes="caption" Text="{loc:Tr Print.Range}" />
                        <RadioButton x:Name="AllRadio" GroupName="Range" IsChecked="True"
                                     Content="{loc:Tr Print.Range.All}" />
                        <RadioButton x:Name="CurrentRadio" GroupName="Range" Content="{loc:Tr Print.Range.Current}" />
                        <RadioButton x:Name="RangeRadio" GroupName="Range" Content="{loc:Tr Print.Range.Custom}" />
                        <TextBox x:Name="RangeBox" Watermark="{loc:Tr Print.Range.Hint}" IsEnabled="False"
                                 Margin="22,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="ErrorLabel" Classes="error-text" IsVisible="False" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
