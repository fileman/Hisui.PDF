<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hisui.Pdf.App.Localization"
        x:Class="Hisui.Pdf.App.Views.UpdateDialog"
        Title="{loc:Tr Update.Title}"
        Width="460" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28,24,28,24" Spacing="10">
        <TextBlock Text="{loc:Tr Update.Heading}" FontSize="18" FontWeight="Bold" />
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <TextBlock Name="NotesText" TextWrapping="Wrap" MaxHeight="140"
                   Foreground="{DynamicResource RibbonSubtleTextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Name="SkipButton" Content="{loc:Tr Update.Skip}" />
            <Button Name="LaterButton" Content="{loc:Tr Update.Later}" IsCancel="True" />
            <Button Name="DownloadButton" Content="{loc:Tr Update.Download}" Classes="primary" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
