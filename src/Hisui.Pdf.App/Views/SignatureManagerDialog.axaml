<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hisui.Pdf.App.Localization"
        x:Class="Hisui.Pdf.App.Views.SignatureManagerDialog"
        Title="{loc:Tr SigManager.Title}"
        Width="560" Height="470"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="16,6" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="20" LastChildFill="True">

        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr SigManager.Title}"
                   Classes="dialog-title" Margin="0,0,0,12" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Content="{loc:Tr SigManager.New}" Name="NewButton" />
            <Button Grid.Column="2" Content="{loc:Tr Cmd.Delete}" Name="DeleteButton"
                    Margin="0,0,8,0" IsEnabled="False" />
            <Button Grid.Column="3" Content="{loc:Tr SigManager.Use}" Name="UseButton"
                    Classes="primary" IsEnabled="False" />
        </Grid>

        <Panel>
            <ListBox Name="SignatureList" SelectionMode="Single" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="156" Margin="4">
                            <Border Background="{DynamicResource RibbonPageBrush}"
                                    BorderBrush="{DynamicResource RibbonDividerBrush}" BorderThickness="1"
                                    CornerRadius="4" Height="84" ClipToBounds="True">
                                <Image Source="{Binding Image}" Stretch="Uniform" Margin="6" />
                            </Border>
                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="EmptyLabel" Text="{loc:Tr SigManager.Empty}"
                       Foreground="{DynamicResource RibbonSubtleTextBrush}"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="False" />
        </Panel>

    </DockPanel>
</Window>
