<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hisui.Pdf.App.Localization"
        xmlns:ctrl="clr-namespace:Hisui.Pdf.App.Controls"
        x:Class="Hisui.Pdf.App.Views.SignatureCreateDialog"
        Title="{loc:Tr SigCreate.Title}"
        Width="500" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="16,6" />
        </Style>
        <Style Selector="RadioButton.mode">
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24,20,24,18" LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="{loc:Tr SigCreate.Title}" Classes="dialog-title" />
        </StackPanel>

        <!-- Mode selector -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Classes="mode" Name="DrawMode"  GroupName="SigMode" IsChecked="True"
                         Content="{loc:Tr SigCreate.Mode.Draw}" />
            <RadioButton Classes="mode" Name="ImageMode" GroupName="SigMode"
                         Content="{loc:Tr SigCreate.Mode.Image}" />
            <RadioButton Classes="mode" Name="TextMode"  GroupName="SigMode"
                         Content="{loc:Tr SigCreate.Mode.Text}" />
        </StackPanel>

        <!-- Footer -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1" Content="{loc:Tr Dialog.Cancel}" Name="CancelButton"
                    IsCancel="True" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="{loc:Tr SigCreate.Save}" Name="SaveButton"
                    Classes="primary" IsDefault="True" />
        </Grid>

        <!-- Name field -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock Classes="caption" Text="{loc:Tr SigCreate.Name}" />
            <TextBox Name="NameInput" Watermark="{loc:Tr SigCreate.NameWatermark}" Padding="8,5" />
        </StackPanel>

        <!-- Content -->
        <StackPanel Spacing="12">

            <Border Name="ErrorBanner" Classes="error-banner" IsVisible="False">
                <TextBlock Name="ErrorLabel" Classes="error-text" />
            </Border>

            <!-- Draw -->
            <StackPanel Name="DrawPanel" Spacing="8">
                <TextBlock Classes="caption" Text="{loc:Tr SigCreate.DrawHint}" />
                <Border Background="{DynamicResource RibbonPageBrush}" BorderBrush="{DynamicResource RibbonDividerBrush}" BorderThickness="1" CornerRadius="4"
                        Height="180" ClipToBounds="True">
                    <ctrl:SignaturePad Name="Pad" />
                </Border>
                <Button Content="{loc:Tr SigCreate.Clear}" Name="ClearButton" HorizontalAlignment="Right" />
            </StackPanel>

            <!-- Image -->
            <StackPanel Name="ImagePanel" Spacing="8" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Name="ImagePathBox" IsReadOnly="True" Padding="8,5"
                             Watermark="{loc:Tr Field.Image.None}" />
                    <Button Grid.Column="1" Content="{loc:Tr Field.Browse}" Name="BrowseButton"
                            Margin="8,0,0,0" />
                </Grid>
                <Border Background="{DynamicResource RibbonPageBrush}" BorderBrush="{DynamicResource RibbonDividerBrush}" BorderThickness="1" CornerRadius="4"
                        Height="180" ClipToBounds="True">
                    <Image Name="ImagePreview" Stretch="Uniform" Margin="6" />
                </Border>
            </StackPanel>

            <!-- Text -->
            <StackPanel Name="TextPanel" Spacing="8" IsVisible="False">
                <TextBlock Classes="caption" Text="{loc:Tr SigCreate.TextHint}" />
                <TextBox Name="TextInput" Watermark="{loc:Tr SigCreate.TextWatermark}" Padding="8,5" />
                <Border Background="{DynamicResource RibbonPageBrush}" BorderBrush="{DynamicResource RibbonDividerBrush}" BorderThickness="1" CornerRadius="4"
                        Height="110" ClipToBounds="True">
                    <TextBlock Name="TextPreview" Text="{Binding #TextInput.Text}"
                               FontFamily="Segoe Script, Brush Script MT" FontStyle="Italic"
                               FontSize="40" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

        </StackPanel>

    </DockPanel>
</Window>
