<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hisui.Pdf.App.Localization"
        x:Class="Hisui.Pdf.App.Views.PasswordDialog"
        Width="400" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI, $Default"
        Background="{DynamicResource RibbonBarBrush}">
    <StackPanel Margin="22" Spacing="14">
        <TextBlock x:Name="PromptLabel" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource RibbonTextBrush}" />
        <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="{loc:Tr Password.Watermark}" />
        <CheckBox x:Name="RevealBox" Content="{loc:Tr Password.Reveal}"
                  Foreground="{DynamicResource RibbonSubtleTextBrush}" />
        <TextBlock x:Name="ErrorLabel" Classes="error-text" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="{loc:Tr Dialog.Cancel}" Padding="16,6" IsCancel="True" />
            <Button x:Name="OkButton" Content="{loc:Tr Dialog.Ok}" Classes="primary" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
