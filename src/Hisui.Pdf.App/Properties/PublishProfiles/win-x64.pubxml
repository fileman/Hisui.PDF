<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish via profile:
    dotnet publish src\Hisui.Pdf.App\Hisui.Pdf.App.csproj /p:PublishProfile=win-x64
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native DLLs (PDFium, Skia, HarfBuzz, ANGLE, Tesseract) ship beside the EXE instead of inside it. Bundled, they
         were extracted to %TEMP%\.net on first run of every version and again whenever Windows cleaned %TEMP%
         (~38 MB written and AV-scanned before the window appeared), and the EXE itself was larger to scan.
         The MSI (Product.wxs) and MSIX (build\package-win.ps1) install these files next to the EXE. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed bundle starts faster (no per-launch decompression); ReadyToRun precompiles managed code to cut JIT time. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Trimming breaks Avalonia XAML binding reflection and System.Text.Json source-gen fallbacks. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
