<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hisui.Pdf.App.App"
             RequestedThemeVariant="Default">

    <!-- Fluent / WinUI design tokens, mapped to Light / Dark theme dictionaries per the
         Ribbon handoff spec. Reference everywhere via {DynamicResource ...} so the active
         OS theme variant picks the right palette automatically. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ── Light · Mica ── -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RibbonAccentBrush"      Color="#005FB8" />
                    <SolidColorBrush x:Key="RibbonOnAccentBrush"    Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RibbonAccentSoftBrush"  Color="#10005FB8" />
                    <SolidColorBrush x:Key="RibbonWindowBrush"      Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RibbonBarBrush"         Color="#F6F6F6" />
                    <SolidColorBrush x:Key="RibbonTabStripBrush"    Color="#FAFAFA" />
                    <SolidColorBrush x:Key="RibbonStatusBrush"      Color="#FAFAFA" />
                    <SolidColorBrush x:Key="RibbonThumbPanelBrush"  Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RibbonPreviewBrush"     Color="#E8E8E8" />
                    <SolidColorBrush x:Key="RibbonTextBrush"        Color="#1A1A1A" />
                    <SolidColorBrush x:Key="RibbonSubtleTextBrush"  Color="#5D5D5D" />
                    <SolidColorBrush x:Key="RibbonCaptionBrush"     Color="#6A6A66" />
                    <SolidColorBrush x:Key="RibbonDividerBrush"     Color="#0F000000" />
                    <SolidColorBrush x:Key="RibbonHoverBrush"       Color="#0A000000" />
                    <SolidColorBrush x:Key="RibbonDisabledBrush"    Color="#9A9A9A" />
                    <SolidColorBrush x:Key="RibbonSuccessBrush"     Color="#3AA76D" />
                    <SolidColorBrush x:Key="RibbonCriticalBrush"    Color="#C42B1C" />
                    <SolidColorBrush x:Key="RibbonCriticalSoftBrush"   Color="#FDECEA" />
                    <SolidColorBrush x:Key="RibbonCriticalBorderBrush" Color="#F1C7C2" />
                    <SolidColorBrush x:Key="RibbonPageBrush"        Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RibbonPageBorderBrush"  Color="#22000000" />
                </ResourceDictionary>

                <!-- ── Dark · Mica ── -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RibbonAccentBrush"      Color="#60CDFF" />
                    <SolidColorBrush x:Key="RibbonOnAccentBrush"    Color="#10120F" />
                    <SolidColorBrush x:Key="RibbonAccentSoftBrush"  Color="#1460CDFF" />
                    <SolidColorBrush x:Key="RibbonWindowBrush"      Color="#202020" />
                    <SolidColorBrush x:Key="RibbonBarBrush"         Color="#242424" />
                    <SolidColorBrush x:Key="RibbonTabStripBrush"    Color="#262626" />
                    <SolidColorBrush x:Key="RibbonStatusBrush"      Color="#262626" />
                    <SolidColorBrush x:Key="RibbonThumbPanelBrush"  Color="#262626" />
                    <SolidColorBrush x:Key="RibbonPreviewBrush"     Color="#1A1A1A" />
                    <SolidColorBrush x:Key="RibbonTextBrush"        Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RibbonSubtleTextBrush"  Color="#9A9A9A" />
                    <SolidColorBrush x:Key="RibbonCaptionBrush"     Color="#8A8A8A" />
                    <SolidColorBrush x:Key="RibbonDividerBrush"     Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="RibbonHoverBrush"       Color="#0EFFFFFF" />
                    <SolidColorBrush x:Key="RibbonDisabledBrush"    Color="#5A5A5A" />
                    <SolidColorBrush x:Key="RibbonSuccessBrush"     Color="#3AA76D" />
                    <SolidColorBrush x:Key="RibbonCriticalBrush"    Color="#FF99A4" />
                    <SolidColorBrush x:Key="RibbonCriticalSoftBrush"   Color="#3A1F1D" />
                    <SolidColorBrush x:Key="RibbonCriticalBorderBrush" Color="#5C2C28" />
                    <SolidColorBrush x:Key="RibbonPageBrush"        Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RibbonPageBorderBrush"  Color="#33000000" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- ── Shared app-wide styles (single source of truth for dialogs) ───────────── -->

        <!-- Every window defaults to the brand font + bar surface; MainWindow overrides its own. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, $Default" />
            <Setter Property="Background" Value="{DynamicResource RibbonBarBrush}" />
        </Style>

        <!-- Primary (accent) button: brand accent across all states, NOT the OS SystemAccentColor. -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="{DynamicResource RibbonOnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,6" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource RibbonOnAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Foreground" Value="{DynamicResource RibbonOnAccentBrush}" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RibbonAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RibbonAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource RibbonAccentBrush}" />
        </Style>

        <!-- Field caption above an input. -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource RibbonCaptionBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- In-dialog heading. -->
        <Style Selector="TextBlock.dialog-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource RibbonTextBrush}" />
        </Style>

        <!-- Secondary / hint text under a heading. -->
        <Style Selector="TextBlock.dialog-hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource RibbonSubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Validation banner + its text. -->
        <Style Selector="Border.error-banner">
            <Setter Property="Background" Value="{DynamicResource RibbonCriticalSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RibbonCriticalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TextBlock.error-text">
            <Setter Property="Foreground" Value="{DynamicResource RibbonCriticalBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Application.Styles>
</Application>
