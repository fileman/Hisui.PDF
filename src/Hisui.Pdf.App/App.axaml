<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hisui.Pdf.App.App"
             RequestedThemeVariant="Default">

    <!-- Fluent / WinUI design tokens, mapped to Light / Dark theme dictionaries per the
         Ribbon handoff spec. Reference everywhere via {DynamicResource ...} so the active
         OS theme variant picks the right palette automatically. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ── Light · Mica ── -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="RibbonAccentBrush"      Color="#005FB8" />
                    <SolidColorBrush x:Key="RibbonOnAccentBrush"    Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RibbonAccentSoftBrush"  Color="#10005FB8" />
                    <SolidColorBrush x:Key="RibbonWindowBrush"      Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RibbonBarBrush"         Color="#F6F6F6" />
                    <SolidColorBrush x:Key="RibbonTabStripBrush"    Color="#FAFAFA" />
                    <SolidColorBrush x:Key="RibbonStatusBrush"      Color="#FAFAFA" />
                    <SolidColorBrush x:Key="RibbonThumbPanelBrush"  Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RibbonPreviewBrush"     Color="#E8E8E8" />
                    <SolidColorBrush x:Key="RibbonTextBrush"        Color="#1A1A1A" />
                    <SolidColorBrush x:Key="RibbonSubtleTextBrush"  Color="#5D5D5D" />
                    <SolidColorBrush x:Key="RibbonCaptionBrush"     Color="#6A6A66" />
                    <SolidColorBrush x:Key="RibbonDividerBrush"     Color="#0F000000" />
                    <SolidColorBrush x:Key="RibbonHoverBrush"       Color="#0A000000" />
                    <SolidColorBrush x:Key="RibbonDisabledBrush"    Color="#9A9A9A" />
                    <SolidColorBrush x:Key="RibbonSuccessBrush"     Color="#3AA76D" />
                    <SolidColorBrush x:Key="RibbonCriticalBrush"    Color="#C42B1C" />
                    <SolidColorBrush x:Key="RibbonPageBrush"        Color="#FFFFFF" />
                </ResourceDictionary>

                <!-- ── Dark · Mica ── -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RibbonAccentBrush"      Color="#60CDFF" />
                    <SolidColorBrush x:Key="RibbonOnAccentBrush"    Color="#10120F" />
                    <SolidColorBrush x:Key="RibbonAccentSoftBrush"  Color="#1460CDFF" />
                    <SolidColorBrush x:Key="RibbonWindowBrush"      Color="#202020" />
                    <SolidColorBrush x:Key="RibbonBarBrush"         Color="#242424" />
                    <SolidColorBrush x:Key="RibbonTabStripBrush"    Color="#262626" />
                    <SolidColorBrush x:Key="RibbonStatusBrush"      Color="#262626" />
                    <SolidColorBrush x:Key="RibbonThumbPanelBrush"  Color="#262626" />
                    <SolidColorBrush x:Key="RibbonPreviewBrush"     Color="#1A1A1A" />
                    <SolidColorBrush x:Key="RibbonTextBrush"        Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RibbonSubtleTextBrush"  Color="#9A9A9A" />
                    <SolidColorBrush x:Key="RibbonCaptionBrush"     Color="#8A8A8A" />
                    <SolidColorBrush x:Key="RibbonDividerBrush"     Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="RibbonHoverBrush"       Color="#0EFFFFFF" />
                    <SolidColorBrush x:Key="RibbonDisabledBrush"    Color="#5A5A5A" />
                    <SolidColorBrush x:Key="RibbonSuccessBrush"     Color="#3AA76D" />
                    <SolidColorBrush x:Key="RibbonCriticalBrush"    Color="#C42B1C" />
                    <SolidColorBrush x:Key="RibbonPageBrush"        Color="#FFFFFF" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
