<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="Hisui PDF"
    Manufacturer="Emanuele Filardo"
    Version="$(var.Version)"
    UpgradeCode="{D0D429B5-9CCA-408E-931D-1643E11FE0AD}"
    Scope="perMachine">

    <!-- Remove any earlier version before installing; block downgrades -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Hisui PDF is already installed." />

    <!-- Embed CAB inside the MSI for a single-file distribution -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Built-in WiX UI: Welcome → License → Install directory → Progress → Finish -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <!-- Install location: C:\Program Files\Hisui PDF\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hisui PDF">
        <!-- licenses\ subdirectory -->
        <Directory Id="LicensesFolder" Name="licenses" />
        <Directory Id="TessdataFolder" Name="tessdata" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu folder -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Hisui PDF" />
    </StandardDirectory>

    <Icon Id="AppIcon.ico" SourceFile="..\Hisui.Pdf.App\Assets\HisuiPDF.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <Feature Id="MainFeature" Title="Hisui PDF" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="LicenseFiles" />
      <ComponentGroupRef Id="TessdataFiles" />
      <ComponentRef Id="PdfDocumentIcon" />
      <ComponentRef Id="OpenWithPdf" />
      <ComponentRef Id="ContextMenuPdf" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>

  <!-- ─── Application files ──────────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">

      <Component Id="MainExe" Guid="*">
        <!-- tessdata is NOT inside the single-file EXE; installed beside it (see TessdataFiles) -->
        <File Id="HisuiExe"
              Source="..\..\bin\publish\win-x64\Hisui.Pdf.App.exe"
              KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ─── OCR language data (tessdata\*.traineddata next to the EXE) ─────── -->
  <Fragment>
    <ComponentGroup Id="TessdataFiles" Directory="TessdataFolder">
      <Component Id="TessEng" Guid="*"><File Source="../../bin/publish/win-x64/tessdata/eng.traineddata" /></Component>
      <Component Id="TessIta" Guid="*"><File Source="../../bin/publish/win-x64/tessdata/ita.traineddata" /></Component>
    </ComponentGroup>
  </Fragment>

  <!-- ─── "Open with" entry for .pdf (does not take over the default app) ─ -->
  <!-- Once the user makes Hisui PDF the default app for .pdf, Explorer shows the ProgId's DefaultIcon on every
       PDF: a document icon (red PDF label, original artwork) rather than the app logo. The Capabilities +
       RegisteredApplications values list Hisui PDF in Settings > Default apps. -->
  <Fragment>
    <!-- The icon is a component of its own: WiX cannot derive a GUID for one holding both a file and registry values. -->
    <Component Id="PdfDocumentIcon" Directory="INSTALLFOLDER" Guid="*">
      <File Id="PdfDocumentIco" Source="..\Hisui.Pdf.App\Assets\filetype\PdfDocument.ico" KeyPath="yes" />
    </Component>
    <Component Id="OpenWithPdf" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="HisuiPDF.Document" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="Software\Classes\HisuiPDF.Document" Type="string" Value="PDF Document" />
      <RegistryValue Root="HKLM" Key="Software\Classes\HisuiPDF.Document\DefaultIcon" Type="string" Value="[INSTALLFOLDER]PdfDocument.ico" />
      <RegistryValue Root="HKLM" Key="Software\HisuiPDF\Capabilities" Name="ApplicationName" Type="string" Value="Hisui PDF" />
      <RegistryValue Root="HKLM" Key="Software\HisuiPDF\Capabilities" Name="ApplicationDescription" Type="string" Value="PDF editor: merge, split, annotate, redact, sign" />
      <RegistryValue Root="HKLM" Key="Software\HisuiPDF\Capabilities\FileAssociations" Name=".pdf" Type="string" Value="HisuiPDF.Document" />
      <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Hisui PDF" Type="string" Value="Software\HisuiPDF\Capabilities" />
      <RegistryValue Root="HKLM" Key="Software\Classes\HisuiPDF.Document\shell\open" Name="FriendlyAppName" Type="string" Value="Hisui PDF" />
      <RegistryValue Root="HKLM" Key="Software\Classes\HisuiPDF.Document\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]Hisui.Pdf.App.exe&quot; &quot;%1&quot;" KeyPath="yes" />
    </Component>
  </Fragment>

  <!-- ─── Explorer right-click "Open with Hisui PDF" (also shown when several PDFs are selected;
         the "Open with" submenu is hidden for multi-selection). Explorer runs the command once per file. ─ -->
  <Fragment>
    <Component Id="ContextMenuPdf" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.Open" Name="MUIVerb" Type="string" Value="Open with Hisui PDF" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.Open" Name="Icon" Type="string" Value="[INSTALLFOLDER]Hisui.Pdf.App.exe,0" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.Open\command" Type="string" Value="&quot;[INSTALLFOLDER]Hisui.Pdf.App.exe&quot; &quot;%1&quot;" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.ToWord" Name="MUIVerb" Type="string" Value="Convert to Word with Hisui PDF" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.ToWord" Name="Icon" Type="string" Value="[INSTALLFOLDER]Hisui.Pdf.App.exe,0" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.ToWord\command" Type="string" Value="&quot;[INSTALLFOLDER]Hisui.Pdf.App.exe&quot; --convert docx &quot;%1&quot;" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.ToImages" Name="MUIVerb" Type="string" Value="Convert to images with Hisui PDF" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.ToImages" Name="Icon" Type="string" Value="[INSTALLFOLDER]Hisui.Pdf.App.exe,0" />
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\HisuiPdf.ToImages\command" Type="string" Value="&quot;[INSTALLFOLDER]Hisui.Pdf.App.exe&quot; --convert png &quot;%1&quot;" />
    </Component>
  </Fragment>

  <!-- ─── License files ──────────────────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="LicenseFiles">

      <Component Id="LicenseMit" Directory="INSTALLFOLDER" Guid="*">
        <File Source="..\..\LICENSE" />
      </Component>

      <Component Id="LicenseNotices" Directory="INSTALLFOLDER" Guid="*">
        <File Source="..\..\THIRD-PARTY-NOTICES.txt" />
      </Component>

      <Component Id="LicenseApache" Directory="LicensesFolder" Guid="*">
        <File Source="..\..\licenses\LICENSE-2.0.txt" />
      </Component>

      <Component Id="LicenseOfl" Directory="LicensesFolder" Guid="*">
        <File Source="..\..\licenses\OFL.txt" />
      </Component>

      <Component Id="LicenseOflLiberation" Directory="LicensesFolder" Guid="*">
        <File Source="..\..\licenses\OFL-Liberation.txt" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ─── Start Menu shortcut ────────────────────────────────────────────── -->
  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="*">
      <Shortcut Id="AppShortcut"
                Name="Hisui PDF"
                Description="PDF editor: merge, split, annotate, redact, sign"
                Target="[INSTALLFOLDER]Hisui.Pdf.App.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <!-- No Icon=: an Icon-table icon lives in %WINDIR%\Installer\{ProductCode}\, which every upgrade
           (new ProductCode) deletes, breaking taskbar pins copied from this shortcut. Without it the
           shortcut shows the EXE's embedded icon from a path that survives upgrades. -->
      <!-- Clean up the Start Menu folder on uninstall -->
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <!-- Registry key used as the component's KeyPath (required for shortcut components) -->
      <RegistryValue Root="HKCU"
                     Key="Software\HisuiPDF"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
