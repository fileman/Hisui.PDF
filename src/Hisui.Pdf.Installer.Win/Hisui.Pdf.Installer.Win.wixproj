<Project Sdk="WixToolset.Sdk/4.0.5">

  <PropertyGroup>
    <Platform>x64</Platform>
    <!-- Override at build time: dotnet build -p:Version=1.2.3 -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <OutputName>HisuiPDF-$(Version)-win-x64</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin\installer\</OutputPath>
    <!-- Pass Version to the WiX preprocessor as $(var.Version) -->
    <DefineConstants>Version=$(Version)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- WiX built-in installer UI (welcome + license + install-dir + progress + finish) -->
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

</Project>
