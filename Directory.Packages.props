<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- PDF engine: all free/MIT-Apache. PDFsharp = structural+write ops, PdfPig = read/extract,
       PDFtoImage = page rendering to PNG (PDFium + SkiaSharp, pulled transitively). -->
  <ItemGroup Label="PDF engine">
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <PackageVersion Include="PdfPig" Version="0.1.14" />
    <PackageVersion Include="PDFtoImage" Version="5.2.1" />
    <!-- OCR for scanned PDFs (Tesseract 5 engine). Apache-2.0; bundles Windows natives,
         uses system libtesseract/libleptonica on Linux/macOS. -->
    <PackageVersion Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- MVVM + Generic Host for the app. -->
  <ItemGroup Label="App / MVVM / Hosting">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
  </ItemGroup>

  <!-- Avalonia UI — cross-platform desktop (Windows / Linux / macOS). -->
  <ItemGroup Label="Avalonia">
    <PackageVersion Include="Avalonia" Version="11.2.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.2.0" />
  </ItemGroup>

  <!-- Test stack: xUnit v3 on Microsoft Testing Platform (NOT VSTest), Moq. -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Moq" Version="4.20.72" />
  </ItemGroup>

</Project>
